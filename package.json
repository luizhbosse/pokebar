{
  "name": "pokebar",
  "version": "0.1.0",
  "description": "Jogo idle de Pokémon (Gen 1 e 2) numa faixa acima da barra de tarefas do Windows. Uso pessoal.",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "data": "node scripts/build-data.mjs",
    "sim": "tsx scripts/sim.ts",
    "dist": "electron-vite build && electron-builder --win portable"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "@types/node": "22.20.5",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "pixi.js": "8.22.0",
    "preact": "11.1.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "com.pokebar.app",
    "productName": "pokebar",
    "files": [
      "out/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": "portable",
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "pokebar-${version}-portable.exe"
    }
  }
}
